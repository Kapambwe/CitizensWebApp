{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://identity.gov.zm/schemas/v1/EducationalCredential.json",
  "title": "Educational Credential",
  "description": "JSON Schema for academic achievements aligned with Europass and W3C Learning Model.",
  "type": "object",
  "properties": {
    "credentialId": { "type": "string" },
    "studentName": { "type": "string" },
    "institutionName": { "type": "string" },
    "qualificationTitle": { "type": "string", "description": "e.g., Bachelor of Science in Computer Science" },
    "qualificationType": { "type": "string", "enum": ["Certificate", "Diploma", "Degree", "Masters", "PhD"] },
    "fieldOfStudy": { "type": "string" },
    "dateOfAward": { "type": "string", "format": "date" },
    "grade": { "type": "string" },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "grade": { "type": "string" }
        }
      }
    }
  },
  "required": ["studentName", "institutionName", "qualificationTitle", "dateOfAward"]
}
