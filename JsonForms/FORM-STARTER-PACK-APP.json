      "fields": [
        { "id": "biz_name", "label": "Business Name", "type": "text", "required": true, "bindingProperty": "BusinessName" },
        { "id": "pacra_no", "label": "PACRA Registration Number", "type": "text", "required": true, "bindingProperty": "RegistrationNumber" }
      ]
    },
    {
      "sectionTitle": "Capacity and Commitment",
      "fields": [
        { "id": "current_capacity", "label": "Current Production Capacity (per month)", "type": "number", "required": true, "bindingProperty": "CurrentCapacity" },
