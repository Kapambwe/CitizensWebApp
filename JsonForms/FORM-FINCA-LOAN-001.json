{
  "FormId": "FORM-FINCA-LOAN-001",
  "FormName": "FINCA Agri-Loan Application",
  "Sections": [
    {
      "SectionTitle": "Loan Specification",
      "Fields": [
        { "Id": "loan_amount", "Label": "Requested Amount (ZMW)", "Type": "number", "Required": true, "BindingProperty": "RequestedAmount", "Placeholder": "Enter amount (e.g., 5000)" },
        { "Id": "loan_purpose", "Label": "Detailed Purpose of Loan", "Type": "textarea", "Required": true, "BindingProperty": "LoanPurpose", "Placeholder": "How will this loan help your business?" },
        {
          "Id": "tenure",
          "Label": "Repayment Tenure",
          "Type": "select",
          "Required": true,
          "BindingProperty": "LoanTenure",
          "Options": [
            { "Value": "3", "Text": "3 Months" },
            { "Value": "6", "Text": "6 Months" },
            { "Value": "12", "Text": "12 Months" },
            { "Value": "18", "Text": "18 Months" },
            { "Value": "24", "Text": "24 Months" }
          ]
        }
      ]
    },
    {
      "SectionTitle": "Business / Farm Details",
      "Fields": [
        { "Id": "biz_type", "Label": "Type of Business/Crop", "Type": "text", "Required": true, "BindingProperty": "BusinessType" },
        { "Id": "biz_location", "Label": "Physical Location", "Type": "text", "Required": true, "BindingProperty": "BusinessLocation" },
        { "Id": "years_active", "Label": "Years in Operation", "Type": "number", "Required": true, "BindingProperty": "YearsActive" }
      ]
    }
  ]
}
