      "title": "Kanyama Drainage and Flood Resilience Project",
      "summary": "Lusaka City Council is seeking resident input on drainage improvements, safe pedestrian crossings and support for households affected by construction.",
      "issuerName": "Lusaka City Council",
      "scope": "LocalityProject",
      "locality": "Kanyama, Lusaka",
      "opensAt": "2026-09-01T08:00:00Z",
      "closesAt": "2026-10-31T17:00:00Z",
      "isActive": true,
      "feedbackPrompt": "What is your overall view of the proposed project?",
      "feedbackOptions": ["Strongly support", "Support", "Not sure yet", "Oppose", "Strongly oppose"],
      "topics": ["Flood prevention", "Road and pedestrian access", "Construction disruption", "Household support"],
      "privacyNotice": "Your response will be reported in summary form to Lusaka City Council. Your name and contact details will not be published with your comments.",
      "formDefinition": {
        "formId": "lusaka-kanyama-drainage-2026",
        "version": "1.0",
        "formName": "Kanyama drainage project response",
        "purpose": "Help the council improve the project design and construction plan.",
        "estimatedMinutes": 5,
        "sections": [
          {
            "sectionTitle": "Your experience",
            "fields": [
              {
                "id": "drainage-experience",
                "label": "How does flooding currently affect your household or business?",
                "type": "select",
                "bindingProperty": "DrainageExperience",
                "required": true,
                "options": [{"value":"Frequently","text":"Frequently"},{"value":"Sometimes","text":"Sometimes"},{"value":"Rarely","text":"Rarely"},{"value":"NotAffected","text":"Not affected"}]
              },
              {
                "id": "priority-location",
                "label": "Which location should receive attention first?",
                "type": "textarea",
                "placeholder": "For example, a road, crossing, school or market area",
                "bindingProperty": "PriorityLocation",
                "required": true,
                "validation": {"maxLength":500,"errorMessage":"Please use no more than 500 characters."}
              }
            ]
          },
          {
            "sectionTitle": "Project priorities",
            "fields": [
              {
                "id": "preferred-priority",
                "label": "What should the project prioritise?",
                "type": "select",
                "bindingProperty": "PreferredPriority",
                "required": true,
                "options": [{"value":"DrainageCapacity","text":"Larger or improved drains"},{"value":"SafeCrossings","text":"Footbridges and safe crossings"},{"value":"RoadAccess","text":"Keeping roads usable during rain"},{"value":"Maintenance","text":"Long-term cleaning and maintenance"}]
              },
              {
                "id": "additional-comments",
                "label": "What else should the council know?",
                "type": "textarea",
                "bindingProperty": "AdditionalComments",
                "required": false,
                "validation": {"maxLength":1000,"errorMessage":"Please use no more than 1,000 characters."}
              }
            ]
          }
        ]
      }
    },
